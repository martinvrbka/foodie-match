# Copy to .env and fill in from Supabase dashboard → Project Settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Seed script only. NEVER prefix with EXPO_PUBLIC_ (that would ship it in the app).
SUPABASE_SECRET_KEY=sb_secret_...

# Only for `npm run db:push` (uploading database changes). Never EXPO_PUBLIC_.
# Access token: supabase.com → your avatar → Account preferences → Access Tokens → Generate new token.
SUPABASE_ACCESS_TOKEN=sbp_...
# Database password: the one chosen when creating the project (Project Settings → Database → Reset if forgotten).
SUPABASE_DB_PASSWORD=
