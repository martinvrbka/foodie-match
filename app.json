{
  "expo": {
    "name": "Foodie Match",
    "slug": "foodie-match",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF8F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.martin.foodiematch"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Foodie Match uses the camera to scan your partner’s pairing QR code."
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "scheme": "foodiematch",
    "experiments": {
      "typedRoutes": true
    }
  }
}
