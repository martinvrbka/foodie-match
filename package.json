{
  "name": "foodie-match",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "expo": "~57.0.25",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "supabase": "^2.118.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "seed": "node --experimental-strip-types scripts/seed/themealdb.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:db": "jest -c jest.db.config.js --runInBand",
    "db:types": "supabase gen types typescript --local > src/data/database.types.ts",
    "db:push": "scripts/db-push.sh"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
